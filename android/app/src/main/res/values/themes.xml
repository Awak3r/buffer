<resources>
    <style name="Theme.Buffer" parent="android:style/Theme.Material.Light">
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:windowBackground">@color/ui_page</item>
        <item name="android:statusBarColor">@color/ui_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/ui_page</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Buffer.Main" parent="Theme.Buffer">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
    <style name="Theme.Buffer.Quick" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowMinWidthMinor">86%</item>
        <item name="android:windowMinWidthMajor">54%</item>
    </style>
    <style name="BufferTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="BufferBody">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="BufferAction" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_action_primary</item>
        <item name="android:textColor">@color/action_primary_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="BufferAction.Secondary" parent="BufferAction">
        <item name="android:background">@drawable/bg_action_secondary</item>
        <item name="android:textColor">@color/action_secondary_text</item>
    </style>
</resources>
