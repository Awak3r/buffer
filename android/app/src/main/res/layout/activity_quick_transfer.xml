<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_buffer_mark"/>

        <TextView
            android:id="@+id/quick_title"
            style="@style/BufferTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"/>
    </LinearLayout>

    <TextView
        android:id="@+id/quick_status"
        style="@style/BufferBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/quick_preparing"/>

    <ProgressBar
        android:id="@+id/quick_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateTint="@color/ui_accent"/>

    <Button
        android:id="@+id/quick_close"
        style="@style/BufferAction.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/quick_close"
        android:visibility="gone"/>
</LinearLayout>
